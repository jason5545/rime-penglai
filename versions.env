# 鎖定的上游版本（build.sh 用）。跟上游同步時改這裡，再重跑 build.sh 和 tools/prodvar.sh 驗證。
# Squirrel 釘 master 46962d2：Nightly（2026-10-21，tag latest）就是這個 commit 建的，CI 綠燈；內建 librime 1.17.0（33e7814）。
# 外掛照 librime 1.17.0 官方 macOS 包的 version-info.txt：lua ec52e48、octagram dfcc151、predict 920bd41。
LIBRIME_COMMIT=33e78140250125871856cdc5b42ddc6a5fcd3cd4      # rime/librime 1.17.0
# librime 的改動在 jason5545/librime 的 penglai 分支（10/31 起，取代 patches/librime）：LIBRIME_COMMIT 加上 commit 標題開頭 0001–0030、0037 起那些（0031–0036 是 pmax-0036 分支用掉的編號，沒進 penglai；同樣的改動 11/1 重新編號成 0042–0047）。
# 文件裡的「librime patch 00NN」「patches/librime/00NN」就是標題開頭 00NN 的那個 commit。改了就 push，再把這裡換成新的 commit
LIBRIME_REPO=https://github.com/jason5545/librime.git
LIBRIME_PENGLAI_COMMIT=f1f45e984ae8e65b2189bf24ea11621d777c037a
LUA_COMMIT=ec52e48ea18f11af37717a01c337f853215cf70b          # hchunhui/librime-lua（2026-05-02）
LUA_THIRDPARTY_COMMIT=9e5bb71db1544913f8005dadc3df8439c00d08b7  # librime-lua thirdparty 分支（lua 5.4.9；官方 1.17.0 建置時是 5.4.8 的 fa40fad）
OCTAGRAM_COMMIT=dfcc15115788c828d9dd7b4bff68067d3ce2ffb8     # lotem/librime-octagram（2024-11，7 月編碼修正之前；官方 1.17.0 也是這版）
PREDICT_COMMIT=920bd41ebf6f9bf6855d14fbe80212e54e749791      # rime/librime-predict（2024-11）
SQUIRREL_COMMIT=46962d2efae5be70389c778d0a6c52f669072827     # rime/squirrel master（1.1.2 之後 34 個 commit，含 #1142）
SABLE_VERSION=1.0.3   # 貂毫的版本號（build.sh 寫進 Info.plist；發布用 tools/release.sh）
SIGN_IDENTITY="Apple Development: Jui Chen Chien (4L22S63983)"  # Team MW4GWYGX56
SIGN_TEAM=MW4GWYGX56   # 發布（tools/release.sh）用 Xcode 雲端簽 Developer ID、送公證的團隊

# 讀音校正（tools/gen_terra_tw.py）的臺灣讀音來源，10/28 鎖定
MCBOPOMOFO_COMMIT=18e2060dd5d0b511753ad79a8fe0d112e944f1af   # openvanilla/McBopomofo（MIT）：Source/Data 的 BPMFBase.txt、BPMFMappings.txt
MOEDICT_COMMIT=a6dc997417507eb510fc29822bc514de2c92728c      # g0v/moedict-data：dict-revised.json.xz（教育部重編國語辭典修訂本）

# 貂毫的 SharedSupport、產生器和工具讀的上游資料（docs/sable.md 第 3 節），10/28 鎖定。前四個跟官方 Squirrel 1.1.2 附的逐位元組相同。
# tools/upstream.py 依這裡下載到 .build/twdata/<commit 前 12 碼>/，不再讀已安裝的 SharedSupport。
TERRA_PINYIN_COMMIT=fa30016a9db2cf7d546ce33968c311525f0d90a0  # rime/rime-terra-pinyin：terra_pinyin.dict.yaml（gen_terra_tw.py 的地球拼音來源，不放進 App）
ESSAY_COMMIT=816b9eeab0f012e896d6c8d4f9b19f1524574378         # rime/rime-essay：essay.txt
PRELUDE_COMMIT=db691d2420b8e656a79692a94f9db0fb3e7aa12b       # rime/rime-prelude：key_bindings.yaml、punctuation.yaml（default.yaml 用 rime-config/ 自己那份）
STROKE_COMMIT=3a4b0f4013e2b4c14b1e80c92b1d4723eb65f39c        # rime/rime-stroke：stroke.dict.yaml、stroke.schema.yaml（筆畫反查）
OCTAGRAM_DATA_COMMIT=bb8e1313552f0f27f2f968031dfaf4563e55d982 # lotem/rime-octagram-data hant 分支：zh-hant-t-essay-bgw.gram（重建個人語言模型用，不放進 App）
# 公開版的聯想資料：rime/librime-predict release data-1.0 的 predict.db（lotem 2023-10-31，「made from essay + octagram」），
# 放進貂毫 SharedSupport 改名 penglai_predict.db；使用者資料夾有同名檔（例如從自己的文字建的）時用使用者的。release 沒寫授權，
# 兩個來源 rime-essay、rime-octagram-data 都是 LGPL-3.0，SharedSupport 另附 penglai_predict.LICENSE.txt（tools/upstream.py 產生）
PREDICT_DATA_URL=https://github.com/rime/librime-predict/releases/download/data-1.0/predict.db
PREDICT_DATA_SHA256=2a5a2b7c77f8f3d7c0836dfc8fd8b791ac2574d8bd93a3a2baaae1ee4861f5be
# 中英混輸的公開版資料（放進貂毫 SharedSupport）：penglai_en.txt、penglai_judge.tbl、penglai_keylid.tbl。
# repo 不放（66 MB），tools/upstream.py 第一次用到時在本機產生（wordfreq 裝在 .build/wordfreq-<版本>/ 的 venv；中文是 MOEDICT_COMMIT 的
# 教育部辭典、gen_terra_tw.py 產生的詞典），產生完對下面的 sha256，不同就停。改了產生器、詞典讀音、wordfreq 時確定要換才改這裡。
# wordfreq 程式 Apache-2.0、資料 CC BY-SA 4.0；SharedSupport 另附 penglai_en.LICENSE.txt（tools/upstream.py 產生）
WORDFREQ_VERSION=3.1.1
PENGLAI_EN_SHA256=132354c2021e00b7a73e092d06ec1a070e58567798a37bf78023c9270db0d972
PENGLAI_JUDGE_SHA256=388f6dc381b0bcd0e890c1dc3389746a5534a7d8c9c38780cf4ea91072f21369
PENGLAI_KEYLID_SHA256=3e991813e423ce987de6f54e2ab0f12857658b9f9968e54a3b58732555a82b24
