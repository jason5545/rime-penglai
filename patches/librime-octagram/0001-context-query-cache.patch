     for (auto i = 0; i < num_results; ++i) {
       const auto& match(matches[i]);
       const int match_len = grammar::unicode_length(word_query, match.length);
-      DLOG(INFO) << "match[" << match.length << "] = "
-                 << scale_value(match.value);
       const int collocation_len = context_len + match_len;
+      // matches_whole_query：最長的那個後綴（整段前文）、詞也整段對上
       if (update_result(result,
                         scale_value(match.value) +
                         (collocation_len >= config_->collocation_min_length ||
-                         matches_whole_query(context_ptr, context_query,
-                                             match.length, word_query)
+                         (suffix.offset == 0 &&
+                          static_cast<size_t>(match.length) ==
+                              word_query.length())
                          ? config_->collocation_penalty
                          : config_->weak_collocation_penalty))) {
         DLOG(INFO) << "update: " << context << "[" << context_len << "] + "
diff --git a/src/octagram.h b/src/octagram.h
index 3fa5f73..526c48a 100644
--- a/src/octagram.h
+++ b/src/octagram.h
@@ -25,8 +25,25 @@ class Octagram : public Grammar {
                bool is_rear) override;
 
  private:
+  // 蓬萊：一個前文編碼後的查詢字串，和每個後綴（從最長到一個字）在 trie 上走到的節點
+  struct ContextQuery {
+    struct Suffix {
+      size_t offset;    // 在 query 裡的起點
+      int context_len;  // 這個後綴有幾個字
+      bool found;       // 走得完（GramDb::Lookup 會往下找詞）
+      size_t node_pos;
+    };
+    string query;
+    vector<Suffix> suffixes;
+  };
+  const ContextQuery& PrepareContext(const string& context, int n);
+
   the<GrammarConfig> config_;
   GramDb* db_ = nullptr;
+  // 蓬萊：Poet 對同一個前文連續查很多個詞：前文的編碼和走到的節點記著（只跟前文、資料庫有關）
+  hash_map<string, ContextQuery> contexts_;
+  const string* last_context_ = nullptr;
+  const ContextQuery* last_query_ = nullptr;
 };
 
 class OctagramComponent : public Grammar::Component {
