diff --git a/src/gram_db.cc b/src/gram_db.cc
index d88a8a5..57417b4 100644
--- a/src/gram_db.cc
+++ b/src/gram_db.cc
@@ -102,6 +102,23 @@ bool GramDb::Build(const vector<pair<string, double>>& data) {
   return true;
 }
 
+bool GramDb::Traverse(const string& context, size_t* node_pos) {
+  size_t node = 0;
+  size_t key_pos = 0;
+  trie_->traverse(context.c_str(), node, key_pos);
+  if (key_pos != context.length())
+    return false;
+  *node_pos = node;
+  return true;
+}
+
+int GramDb::LookupFrom(size_t node_pos,
+                       const string& word,
+                       Match results[kMaxResults]) {
+  return trie_->commonPrefixSearch(word.c_str(), results, kMaxResults, 0,
+                                   node_pos);
+}
+
 int GramDb::Lookup(const string& context,
                    const string& word,
                    Match results[kMaxResults]) {
