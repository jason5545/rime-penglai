 src/gram_db.cc  | 17 ++++++++++++++++
 src/gram_db.h   |  5 +++++
 src/octagram.cc | 54 ++++++++++++++++++++++++++++++++++++-------------
 src/octagram.h  | 17 ++++++++++++++++
