   int Lookup(const string& context,
              const string& word,
              Match results[kMaxResults]);
+  // 蓬萊：Lookup 拆成兩步，同一個前文只走一次：先從根走完前文（走不完回傳 false），再從走到的節點找詞
+  bool Traverse(const string& context, size_t* node_pos);
+  int LookupFrom(size_t node_pos,
+                 const string& word,
+                 Match results[kMaxResults]);
 
  private:
   the<Darts::DoubleArray> trie_;
diff --git a/src/octagram.cc b/src/octagram.cc
index 98ace59..f3b3028 100644
--- a/src/octagram.cc
+++ b/src/octagram.cc
@@ -104,6 +104,36 @@ inline static bool matches_whole_query(const char* context_ptr,
       match_length == word_query.length();
 }
 
+// 蓬萊：原本每查一個詞都重新編碼前文、從根走一遍每個後綴（GramDb::Lookup）。前文相同時這兩步的結果相同，
+// 記在 contexts_；走不完的後綴原本 Lookup 回傳 0 筆，這裡直接跳過
+const Octagram::ContextQuery& Octagram::PrepareContext(const string& context,
+                                                       int n) {
+  if (last_context_ && *last_context_ == context)
+    return *last_query_;
+  auto found = contexts_.find(context);
+  if (found == contexts_.end()) {
+    if (contexts_.size() >= 256)
+      contexts_.clear();
+    ContextQuery cq;
+    int context_len = 0;
+    cq.query = grammar::encode(last_n_unicode(context, n, context_len),
+                               str_end(context));
+    for (const char* context_ptr = str_begin(cq.query); context_len > 0;
+         --context_len, context_ptr = grammar::next_unicode(context_ptr)) {
+      ContextQuery::Suffix suffix{
+          static_cast<size_t>(context_ptr - str_begin(cq.query)), context_len,
+          false, 0};
+      // 跟 Lookup(context_ptr, …) 一樣從 const char* 建字串
+      suffix.found = db_->Traverse(string(context_ptr), &suffix.node_pos);
+      cq.suffixes.push_back(suffix);
+    }
+    found = contexts_.emplace(context, std::move(cq)).first;
+  }
+  last_context_ = &found->first;
+  last_query_ = &found->second;
+  return found->second;
+}
+
 double Octagram::Query(const string& context,
                        const string& word,
                        bool is_rear) {
