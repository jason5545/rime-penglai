 namespace rime {
 
+// 蓬萊：聯想只在送出之後跳出，查的是送出紀錄尾巴接起來的那一段（這則訊息到目前送出的字）。
+// 跳過 Return 送出時留下的空 raw（fluency_editor 送出時組字區尾巴是一個空段落）；
+// 遇到標點、按鍵原字（raw、thru）就停，最後一筆就是這種時不聯想（同原版）。
+// last_type 是最後一筆真的送出的紀錄的類型。
+static string RecentText(const CommitHistory& history,
+                         size_t max_chars,
+                         string* last_type) {
+  last_type->clear();
+  string text;
+  size_t chars = 0;
+  for (auto it = history.rbegin(); it != history.rend(); ++it) {
+    if (it->type == "raw" && it->text.empty())
+      continue;
+    if (last_type->empty())
+      *last_type = it->type;
+    if (it->type == "punct" || it->type == "raw" || it->type == "thru")
+      break;
+    text = it->text + text;
+    chars = 0;
+    for (unsigned char c : text) {
+      if ((c & 0xc0) != 0x80)
+        ++chars;
+    }
+    if (max_chars == 0 || chars >= max_chars)
+      break;
+  }
+  return text;
+}
+
+static bool is_modifier(int keycode) {
+  return (keycode >= XK_Shift_L && keycode <= XK_Hyper_R &&
+          keycode != XK_Caps_Lock && keycode != XK_Shift_Lock) ||
+         keycode == XK_ISO_Level3_Shift || keycode == XK_Mode_switch;
+}
+
+static bool is_shift(int keycode) {
+  return keycode == XK_Shift_L || keycode == XK_Shift_R;
+}
