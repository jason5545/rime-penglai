+// 蓬萊：聯想選單開著時，留給選單的鍵。其他鍵一律先收掉聯想，再照沒有選單時處理
+// （Return 交給 App、空白鍵打空白、BackSpace 刪前一個字並撤銷學習、聲調鍵開頭的數字、77…）。
+bool Predictor::KeepsMenu(const KeyEvent& key_event, Context* ctx) const {
+  int ch = key_event.keycode();
+  if (key_event.ctrl() || key_event.alt() || key_event.super())
+    return false;
+  // Shift+數字（key_binder 換成 KP_1…）、KP 數字：選字
+  if (key_event.shift()) {
+    static const string kShiftedDigits = "!@#$%^&*()";
+    return ch < 0x80 && kShiftedDigits.find(char(ch)) != string::npos;
+  }
+  if (ch >= XK_KP_0 && ch <= XK_KP_9)
+    return true;
+  // 移反白、翻頁
+  switch (ch) {
+    case XK_Up:
+    case XK_Down:
+    case XK_KP_Up:
+    case XK_KP_Down:
+    case XK_Page_Up:
+    case XK_Page_Down:
+    case XK_KP_Page_Up:
+    case XK_KP_Page_Down:
+      return true;
+    case XK_Left:
+    case XK_Right:
+    case XK_KP_Left:
+    case XK_KP_Right:
+      // 橫排選字窗：左右鍵移反白
+      return ctx->get_option("_linear") && !ctx->get_option("_vertical");
+  }
+  // 數字選字（penglai_numsel.lua）狀態中，數字鍵選這一頁第 N 個。Lua 把狀態寫在 context 的
+  // penglai_numsel 屬性（on／off），觸發鍵可以換（↓ 或修飾鍵點一下），照屬性判斷；
+  // 沒掛 penglai_numsel（沒有這個屬性）時照原本：移過反白之後數字鍵選字
+  if (ch < '1' || ch > '9')
+    return false;
+  string numsel = ctx->get_property("penglai_numsel");
+  return numsel.empty() ? navigating_ : numsel == "on";
 }
 
