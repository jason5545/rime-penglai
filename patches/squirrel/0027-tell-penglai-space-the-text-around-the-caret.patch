+  private static let spaceContextLength = 100
   private static var unknownAppCnt: UInt = 0
 
   private weak var client: IMKTextInput?
@@ -28,6 +29,9 @@ final class SquirrelInputController: IMKInputController {
   // punctuation), and the punctuation's length.
   private var autoPunct: (caret: Int, text: String, length: Int)?
   private var lastCommitted = ""
+  // The text before the caret sent to librime for this space (see sendSpaceContext()), for checking the punctuation
