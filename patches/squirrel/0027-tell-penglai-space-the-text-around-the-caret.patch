@@ -575,6 +590,101 @@ private extension SquirrelInputController {
     }
   }
 
+  // penglai_space announces penglai_space/foreign by setting the property "penglai_space_foreign" to its schema id
+  // (empty when off). Checking the id keeps a schema switched to later in this session from inheriting it.
+  func spaceContextWanted() -> Bool {
+    guard !schemaId.isEmpty, !rimeAPI.get_option(session, "ascii_mode") else { return false }
+    var buffer = [CChar](repeating: 0, count: 128)
+    guard rimeAPI.get_property(session, "penglai_space_foreign", &buffer, buffer.count) else { return false }
+    return String(cString: buffer) == schemaId
+  }
+
+  // Up to 100 UTF-16 units on each side of the caret, in the properties "penglai_space_before" and
+  // "penglai_space_after"; librime cuts out the sentence and decides (plugins/penglai, penglai_space). Empty when the
+  // client can't tell (terminals), the caret is unknown, text is selected, the client returns something else than
+  // asked, or the text after the caret can't be read (see textAfterCaret(_:_:)). Returns the text before the caret.
+  func sendSpaceContext() -> String {
+    var before = "", after = ""
+    if let client {
+      let caret = client.selectedRange()
+      if caret.location != NSNotFound, caret.length == 0, caret.location > 0 {
+        let start = max(0, caret.location - Self.spaceContextLength)
+        let count = caret.location - start
+        // A range splitting a surrogate pair may come back one unit longer or shorter.
+        if let text = client.attributedSubstring(from: NSRange(location: start, length: count))?.string,
+           abs(text.utf16.count - count) <= 1 {
+          before = text
+        }
+        if !before.isEmpty {
+          if let text = textAfterCaret(client, caret.location).text, text.utf16.count <= Self.spaceContextLength + 1 {
+            after = text
+          } else {
+            // The text after the caret is part of the sentence: when it can't be read, nothing is read.
+            before = ""
+          }
+        }
+      }
+    }
+    rimeAPI.set_property(session, "penglai_space_before", before)
+    rimeAPI.set_property(session, "penglai_space_after", after)
+    return before
+  }
+
+  // Up to 100 UTF-16 units after the caret, nil when they can't be read. `how` says which way they were read (d: at
+  // once; z, l, L: by length(); s: nothing after; a: stringFromRange's actual range; b: by halving; for logs).
+  // Some clients answer nil for a range running past the end instead of clamping it: then ask for the length (only now,
+  // it can be expensive) and ask again within it. A length short of the caret is not a length (T3, an Electron app,
+  // answers 0): the text before the caret was read, so nil for one unit after it means nothing is there (11/3). When
+  // one unit does come back, the client keeps only part of the range (Chromium answers from the text it keeps around
+  // the selection, and IMK drops an answer shorter than asked: 11/4): take the range stringFromRange reports, or else
+  // search for the longest length the client gives, instead of giving up on the text before.
+  func textAfterCaret(_ client: IMKTextInput, _ caret: Int) -> (text: String?, how: String) {
+    let limit = Self.spaceContextLength
+    if let text = client.attributedSubstring(from: NSRange(location: caret, length: limit))?.string {
+      return (text, "d")
+    }
+    let available = client.length() - caret
+    if available == 0 {
+      return ("", "z")
+    }
+    if available > 0 {
+      let text = client.attributedSubstring(from: NSRange(location: caret, length: min(available, limit)))?.string
+      return (text, text == nil ? "L" : "l")
+    }
+    guard let one = client.attributedSubstring(from: NSRange(location: caret, length: 1))?.string else {
+      return ("", "s")
+    }
+    var actual = NSRange(location: NSNotFound, length: 0)
+    if let text = client.string(from: NSRange(location: caret, length: limit), actualRange: &actual),
+       actual.location == caret, actual.length > 0, actual.length <= limit, text.utf16.count == actual.length {
+      return (text, "a")
+    }
+    // The client gives `low` units and not `high`: find the longest range it gives. What comes after the caret is usually
+    // short (the end of the text, a line or two), so grow the range first, then halve between the two. A range ending inside
+    // a surrogate pair may come back nil even though longer ones don't, so a miss is tried one unit longer before it counts
+    // (of two neighbouring ends one is never inside a pair, which keeps the search sound).
+    var good = one, low = 1, high = limit
+    func probe(_ count: Int) -> Bool {
+      for length in [count, count + 1] where length < high {
+        if let text = client.attributedSubstring(from: NSRange(location: caret, length: length))?.string {
+          good = text
+          low = length
+          return true
+        }
+      }
+      high = count
+      return false
+    }
+    var count = 2
+    while count < high, probe(count) {
+      count = low * 2
+    }
+    while high - low > 1 {
+      _ = probe((low + high) / 2)
+    }
+    return (good, "b")
+  }
+
   func replace(_ punct: (caret: Int, text: String, length: Int), with string: String) -> Bool {
     guard let client, preedit.isEmpty, !rimeAPI.get_option(session, "force_marked_text_for_direct_commit") else { return false }
     let caret = client.selectedRange()
