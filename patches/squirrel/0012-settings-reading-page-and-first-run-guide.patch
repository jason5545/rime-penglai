diff --git a/sources/SquirrelInputController.swift b/sources/SquirrelInputController.swift
index 1b9c45d..46364c0 100644
--- a/sources/SquirrelInputController.swift
+++ b/sources/SquirrelInputController.swift
@@ -213,6 +213,7 @@ final class SquirrelInputController: IMKInputController {
       let label = rimeAPI.get_state_label_abbreviated(session, "ascii_mode", state, true).asString
       NSApp.squirrelAppDelegate.updateStatusIcon(asciiMode: state, schemaLabel: label)
     }
+    PenglaiOnboarding.showIfNeeded()
   }
 
   override init!(server: IMKServer!, delegate: Any!, client: Any!) {
@@ -235,6 +236,11 @@ final class SquirrelInputController: IMKInputController {
     ) { [weak self] notification in
       self?.reportASCIIMode(notification)
     }
+
+    // 蓬萊設定改了方案選項（讀音）：這個輸入框的 session 馬上照著改
+    NotificationCenter.default.addObserver(forName: .penglaiSetOptions, object: nil, queue: nil) { [weak self] notification in
+      self?.handlePenglaiOptions(notification)
+    }
   }
 
   override func deactivateServer(_ sender: Any!) {
@@ -646,6 +652,18 @@ private extension SquirrelInputController {
     rimeUpdate()
   }
 
+  /// 跟 F4 選單一樣直接改 session 的選項；組字中就重畫候選（讀音換了，候選跟著換）
+  private func handlePenglaiOptions(_ notification: Notification) {
+    guard let options = notification.object as? [String: Bool] else { return }
+    guard session != 0 && rimeAPI.find_session(session) else { return }
+    for (name, value) in options {
+      rimeAPI.set_option(session, name, value)
+    }
+    if let input = rimeAPI.get_input(session), input.pointee != 0 {
+      rimeUpdate()
+    }
+  }
+
   private func reportASCIIMode(_: Notification) {
     guard client != nil else { return }
     guard session != 0 && rimeAPI.find_session(session) else { return }
