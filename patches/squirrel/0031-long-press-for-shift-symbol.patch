   // swiftlint:disable:next cyclomatic_complexity
   override func handle(_ event: NSEvent!, client sender: Any!) -> Bool {
@@ -71,6 +73,7 @@ final class SquirrelInputController: IMKInputController {
         handled = true
         break
       }
+      longPress.cancel("modifier changed")
       var rimeModifiers: UInt32 = SquirrelKeycode.osxModifiersToRime(modifiers: modifiers)
       // Some remote desktop tools send flagsChanged with keyCode 0; infer the real modifier key when needed.
       var keyCode = event.keyCode
@@ -123,6 +126,20 @@ final class SquirrelInputController: IMKInputController {
       rimeUpdate()
 
     case .keyDown:
+      // Long press (sable/PenglaiLongPress.swift): a key that only added itself to the input, still held after the key
+      // repeat delay, turns into that key's Shift symbol (a timer, or its auto-repeat if the client sends those); its
+      // repeats are dropped. Any other key ends it.
+      if event.isARepeat {
+        switch longPress.onRepeat(keyCode: event.keyCode, timestamp: event.timestamp) {
+        case .pass: break
+        case .swallow: return true
+        case .fire:
+          longPress.fire()
+          return true
+        }
+      } else {
+        longPress.cancel("another key")
+      }
       // The AX experiment (sable/PenglaiAXDiag.swift) is off unless the flag file penglai-axdiag is in the user folder;
       // off, these calls only check for that file every 2 seconds.
       PenglaiAXDiag.shared.noteKeyDown(command: modifiers.contains(.command))
@@ -179,8 +196,14 @@ final class SquirrelInputController: IMKInputController {
                                                  pendingPunct: autoPunct)
           }
           let rimeModifiers = SquirrelKeycode.osxModifiersToRime(modifiers: modifiers)
+          let inputBefore = event.isARepeat ? nil : currentInput()
           handled = processKey(rimeKeycode, modifiers: rimeModifiers)
           rimeUpdate()
+          if let inputBefore, let inputAfter = currentInput() {
+            longPress.noteKey(keyCode: keyCode, char: char,
+                              plain: modifiers.isDisjoint(with: [.shift, .control, .option, .command, .capsLock, .numericPad, .function]),
+                              handled: handled, downTime: event.timestamp, before: inputBefore, after: inputAfter)
+          }
           spaceContext = nil
           if !handled {
             handled = replaceGuessedPunct()
@@ -290,6 +313,7 @@ final class SquirrelInputController: IMKInputController {
     super.init(server: server, delegate: delegate, client: client)
     createSession()
     PenglaiAXDiag.shared.userDir = SquirrelApp.userDir
+    longPress.onFire = { [weak self] armed in self?.fireLongPress(armed) ?? false }
 
     NotificationCenter.default.addObserver(
       forName: .init("SableSetASCIIModeNotification"),
@@ -314,6 +338,10 @@ final class SquirrelInputController: IMKInputController {
   }
 
