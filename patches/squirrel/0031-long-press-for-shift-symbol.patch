diff --git a/sources/SquirrelInputController.swift b/sources/SquirrelInputController.swift
index 5c88a8b..c19cbf6 100644
--- a/sources/SquirrelInputController.swift
+++ b/sources/SquirrelInputController.swift
@@ -42,6 +42,8 @@ final class SquirrelInputController: IMKInputController {
   private var chordTimer: Timer?
   private var chordDuration: TimeInterval = 0
   private var currentApp: String = ""
+  // 長按數字列、標點鍵打出 Shift 的符號（sable/PenglaiLongPress.swift）
+  private var longPress = PenglaiLongPress()
 
   // swiftlint:disable:next cyclomatic_complexity
   override func handle(_ event: NSEvent!, client sender: Any!) -> Bool {
@@ -67,6 +69,7 @@ final class SquirrelInputController: IMKInputController {
 
     switch event.type {
     case .flagsChanged:
+      longPress.reset()
       if lastModifiers == modifiers {
         handled = true
         break
@@ -123,6 +126,19 @@ final class SquirrelInputController: IMKInputController {
       rimeUpdate()
 
     case .keyDown:
+      // Long press (sable/PenglaiLongPress.swift): the first auto-repeat of a key that only added itself to the input turns
+      // it into that key's Shift symbol; later repeats are dropped. Any other key ends it.
+      if event.isARepeat {
+        switch longPress.onRepeat(keyCode: event.keyCode) {
+        case .pass: break
+        case .swallow: return true
+        case .fire(let armed):
+          if !fireLongPress(armed) { longPress.reset() }
+          return true
+        }
+      } else {
+        longPress.reset()
+      }
       // The AX experiment (sable/PenglaiAXDiag.swift) is off unless the flag file penglai-axdiag is in the user folder;
       // off, these calls only check for that file every 2 seconds.
       PenglaiAXDiag.shared.noteKeyDown(command: modifiers.contains(.command))
@@ -179,8 +195,14 @@ final class SquirrelInputController: IMKInputController {
                                                  pendingPunct: autoPunct)
           }
           let rimeModifiers = SquirrelKeycode.osxModifiersToRime(modifiers: modifiers)
+          let inputBefore = event.isARepeat ? nil : currentInput()
           handled = processKey(rimeKeycode, modifiers: rimeModifiers)
           rimeUpdate()
+          if let inputBefore, let inputAfter = currentInput() {
+            longPress.noteKey(keyCode: keyCode, char: char,
+                              plain: modifiers.isDisjoint(with: [.shift, .control, .option, .command, .capsLock, .numericPad, .function]),
+                              handled: handled, before: inputBefore, after: inputAfter)
+          }
           spaceContext = nil
           if !handled {
             handled = replaceGuessedPunct()
@@ -314,6 +336,7 @@ final class SquirrelInputController: IMKInputController {
   }
 
   override func deactivateServer(_ sender: Any!) {
+    longPress.reset()
     hidePalettes()
     commitComposition(sender)
     client = nil
@@ -503,6 +526,31 @@ private extension SquirrelInputController {
     }
   }
 
+  func currentInput() -> (input: String, caret: Int)? {
+    guard session != 0 else { return nil }
+    let input = rimeAPI.get_input(session).map { String(cString: $0) } ?? ""
+    return (input, Int(rimeAPI.get_caret_pos(session)))
+  }
+
+  // The long press fires only if the input is still what the key left (nothing else changed it in between): put back the
+  // input from before the key, commit the composition first for digit keys (Shift+digit selects a candidate while
+  // composing), then send the Shift symbol like a real Shift+key.
+  func fireLongPress(_ armed: PenglaiLongPress.Armed) -> Bool {
+    guard let now = currentInput(), now.input == armed.input, now.caret == armed.caret,
+          !rimeAPI.get_option(session, "ascii_mode"),
+          let symbol = armed.symbol.asciiValue else { return false }
+    _ = rimeAPI.set_input(session, armed.restore)
+    if Int(rimeAPI.get_caret_pos(session)) != armed.restoreCaret {
+      rimeAPI.set_caret_pos(session, armed.restoreCaret)
+    }
+    if armed.digit && !armed.restore.isEmpty {
+      _ = rimeAPI.commit_composition(session)
+    }
+    _ = processKey(UInt32(symbol), modifiers: kShiftMask.rawValue)
+    rimeUpdate()
+    return true
+  }
+
   func processKey(_ rimeKeycode: UInt32, modifiers rimeModifiers: UInt32) -> Bool {
     if let panel = NSApp.squirrelAppDelegate.panel {
       if panel.linear != rimeAPI.get_option(session, "_linear") {
