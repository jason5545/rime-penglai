@@ -330,6 +358,7 @@ final class SquirrelInputController: IMKInputController {
     self.client ?= sender as? IMKTextInput
     if session != 0 {
       if let input = rimeAPI.get_input(session) {
+        longPress.noteClientCommit(input: String(cString: input))
         commit(string: String(cString: input))
         rimeAPI.clear_composition(session)
       }
@@ -396,6 +425,7 @@ final class SquirrelInputController: IMKInputController {
   }
 
   deinit {
+    longPress.reset()
     destroySession()
   }
 }
@@ -503,6 +533,50 @@ private extension SquirrelInputController {
     }
   }
 
+  func currentInput() -> (input: String, caret: Int)? {
+    guard session != 0 else { return nil }
+    let input = rimeAPI.get_input(session).map { String(cString: $0) } ?? ""
+    return (input, Int(rimeAPI.get_caret_pos(session)))
+  }
+
+  // The long press fires only if the input is still what the key left (nothing else changed it in between): put back the
+  // input from before the key, commit the composition first for digit keys (Shift+digit selects a candidate while
+  // composing), then send the Shift symbol like a real Shift+key.
+  // If the client took the composition in the meantime (T3 opens its slash-command menu on a "/" at the start and commits
+  // it), the key's character was committed as is: take it back out of the client first, if it is right before the caret.
+  func fireLongPress(_ armed: PenglaiLongPress.Armed) -> Bool {
+    guard let now = currentInput(), !rimeAPI.get_option(session, "ascii_mode"),
+          let symbol = armed.symbol.asciiValue else { return false }
+    if longPress.clientCommitted && now.input.isEmpty {
+      guard removeBeforeCaret(armed.input) else { return false }
+    } else if now.input != armed.input || now.caret != armed.caret {
+      return false
+    }
+    _ = rimeAPI.set_input(session, armed.restore)
+    if Int(rimeAPI.get_caret_pos(session)) != armed.restoreCaret {
+      rimeAPI.set_caret_pos(session, armed.restoreCaret)
+    }
+    if armed.digit && !armed.restore.isEmpty {
+      _ = rimeAPI.commit_composition(session)
+    }
+    _ = processKey(UInt32(symbol), modifiers: kShiftMask.rawValue)
+    rimeUpdate()
+    return true
+  }
+
+  func removeBeforeCaret(_ text: String) -> Bool {
+    guard let client, preedit.isEmpty else { return false }
+    let caret = client.selectedRange()
+    let count = text.utf16.count
+    guard caret.location != NSNotFound, caret.length == 0, caret.location >= count,
+          client.attributedSubstring(from: NSRange(location: caret.location - count, length: count))?.string == text else {
+      PenglaiLongPress.log.notice("long press: committed key not found before the caret")
+      return false
+    }
+    client.insertText("", replacementRange: NSRange(location: caret.location - count, length: count))
+    return true
+  }
+
   func processKey(_ rimeKeycode: UInt32, modifiers rimeModifiers: UInt32) -> Bool {
     if let panel = NSApp.squirrelAppDelegate.panel {
       if panel.linear != rimeAPI.get_option(session, "_linear") {
