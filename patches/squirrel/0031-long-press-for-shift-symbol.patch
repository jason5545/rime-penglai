@@ -330,6 +331,7 @@
 		B3F0A00B2F26020000AA0001 /* PenglaiAXDiag.swift */ = {isa = PBXFileReference; lastKnownFileType = sourcecode.swift; name = PenglaiAXDiag.swift; path = sources/PenglaiAXDiag.swift; sourceTree = "<group>"; };
 		B3F0A00D2F26020000AA0001 /* PenglaiInstall.swift */ = {isa = PBXFileReference; lastKnownFileType = sourcecode.swift; name = PenglaiInstall.swift; path = sources/PenglaiInstall.swift; sourceTree = "<group>"; };
 		B3F0A00F2F26020000AA0001 /* PenglaiDictionary.swift */ = {isa = PBXFileReference; lastKnownFileType = sourcecode.swift; name = PenglaiDictionary.swift; path = sources/PenglaiDictionary.swift; sourceTree = "<group>"; };
+		B3F0A0112F26020000AA0001 /* PenglaiLongPress.swift */ = {isa = PBXFileReference; lastKnownFileType = sourcecode.swift; name = PenglaiLongPress.swift; path = sources/PenglaiLongPress.swift; sourceTree = "<group>"; };
 /* End PBXFileReference section */
 
 /* Begin PBXFrameworksBuildPhase section */
@@ -368,6 +370,7 @@
 				B3F0A00B2F26020000AA0001 /* PenglaiAXDiag.swift */,
 				B3F0A00D2F26020000AA0001 /* PenglaiInstall.swift */,
 				B3F0A00F2F26020000AA0001 /* PenglaiDictionary.swift */,
+				B3F0A0112F26020000AA0001 /* PenglaiLongPress.swift */,
 				B38E9B8F2BE9AE1E0036ABEF /* Squirrel-Bridging-Header.h */,
 			);
 			name = Sources;
@@ -646,6 +649,7 @@
 				B3F0A00C2F26020000AA0001 /* PenglaiAXDiag.swift in Sources */,
 				B3F0A00E2F26020000AA0001 /* PenglaiInstall.swift in Sources */,
 				B3F0A0102F26020000AA0001 /* PenglaiDictionary.swift in Sources */,
+				B3F0A0122F26020000AA0001 /* PenglaiLongPress.swift in Sources */,
 			);
 			runOnlyForDeploymentPostprocessing = 0;
