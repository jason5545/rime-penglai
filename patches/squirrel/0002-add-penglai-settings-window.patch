diff --git a/sources/SquirrelApplicationDelegate.swift b/sources/SquirrelApplicationDelegate.swift
index 46a9f06..8d8d194 100644
--- a/sources/SquirrelApplicationDelegate.swift
+++ b/sources/SquirrelApplicationDelegate.swift
@@ -78,6 +78,9 @@ final class SquirrelApplicationDelegate: NSObject, NSApplicationDelegate, SPUSta
     }
   }
 
+  /// 蓬萊設定視窗觸發的部署：這一輪不跳通知
+  static var quietDeploy = false
+
   func deploy() {
     print("Start maintenance...")
     self.shutdownRime()
@@ -273,6 +276,11 @@ private func notificationHandler(contextObject: UnsafeMutableRawPointer?, sessio
   let messageValue = messageValueC.map { String(cString: $0) }
 
   if messageType == "deploy" {
+    // 蓬萊設定視窗等部署結果；從設定視窗觸發的部署不跳系統通知（視窗下面的狀態列會顯示）
+    let quiet = SquirrelApplicationDelegate.quietDeploy
+    if messageValue == "success" || messageValue == "failure" { SquirrelApplicationDelegate.quietDeploy = false }
+    DispatchQueue.main.async { NotificationCenter.default.post(name: .penglaiDeployMessage, object: messageValue) }
+    if quiet { return }
     switch messageValue {
     case "start":
       SquirrelApplicationDelegate.showMessage(msgText: NSLocalizedString("deploy_start", comment: ""))
